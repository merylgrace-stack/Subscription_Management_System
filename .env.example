# BrightLoop Software Production Environment Template

# Django Configuration
DJANGO_SECRET_KEY=replace-with-a-random-50-char-secret-key-in-production
DJANGO_DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,brightloop.io

# PostgreSQL Configuration
POSTGRES_DB=brightloop_db
POSTGRES_USER=brightloop_user
POSTGRES_PASSWORD=replace-with-strong-database-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis & Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Stripe Payment Gateway
STRIPE_PUBLIC_KEY=pk_live_your_stripe_public_key
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
